<!--
  ============================================================
  Maven settings.xml — autenticación con GitHub Packages
  ============================================================
  UBICACIÓN en Windows:  C:\Users\{tu-usuario}\.m2\settings.xml
  UBICACIÓN en Linux/Mac: ~/.m2/settings.xml

  PASOS:
  1. Crea un Personal Access Token (PAT) en GitHub:
     https://github.com/settings/tokens
     Permisos necesarios: read:packages

  2. Copia este archivo a la ubicación indicada arriba.

  3. Reemplaza {TU_USUARIO_GITHUB} y {TU_TOKEN_GITHUB} con tus datos.
     NUNCA subas este archivo a Git.

  ============================================================
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
          https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <!-- Credenciales para leer Y publicar en GitHub Packages -->
        <server>
            <id>github</id>
            <username>{TU_USUARIO_GITHUB}</username>
            <password>{TU_TOKEN_GITHUB}</password>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <!-- Repositorio de GitHub Packages de mazkte/reparaya-shared -->
                <repository>
                    <id>github</id>
                    <name>GitHub Packages — mazkte/reparaya-shared</name>
                    <url>https://maven.pkg.github.com/mazkte/reparaya-shared</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <!-- Activar el perfil github por defecto -->
    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>

</settings>
